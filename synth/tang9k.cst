#=========================================================
# Tang Nano 9K
# GW1NR-LV9QN88PC6/I5
#=========================================================

#---------------------------------------------------------
# 27 MHz Clock
#---------------------------------------------------------
IO_LOC  "clk_27mhz" 52;
IO_PORT "clk_27mhz" IO_TYPE=LVCMOS33;

#---------------------------------------------------------
# Buttons (Active-Low)
# buttons_async[0] -> S1 (Pin 4)
# buttons_async[1] -> S2 (Pin 3)
#---------------------------------------------------------
IO_LOC  "buttons_async[0]" 4;
IO_PORT "buttons_async[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP;

IO_LOC  "buttons_async[1]" 3;
IO_PORT "buttons_async[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP;

#---------------------------------------------------------
# LEDs (Active-Low)
#---------------------------------------------------------
IO_LOC  "leds[0]" 10;
IO_PORT "leds[0]" IO_TYPE=LVCMOS18;

IO_LOC  "leds[1]" 11;
IO_PORT "leds[1]" IO_TYPE=LVCMOS18;

IO_LOC  "leds[2]" 13;
IO_PORT "leds[2]" IO_TYPE=LVCMOS18;

IO_LOC  "leds[3]" 14;
IO_PORT "leds[3]" IO_TYPE=LVCMOS18;

IO_LOC  "leds[4]" 15;
IO_PORT "leds[4]" IO_TYPE=LVCMOS18;

IO_LOC  "leds[5]" 16;
IO_PORT "leds[5]" IO_TYPE=LVCMOS18;

#---------------------------------------------------------
# Onboard USB-UART (BL702)
#---------------------------------------------------------
IO_LOC  "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;

IO_LOC  "uart_rx_async" 18;
IO_PORT "uart_rx_async" IO_TYPE=LVCMOS33;

#---------------------------------------------------------
# GPIOs (External pins)
#---------------------------------------------------------
IO_LOC  "gpioa[0]" 25;
IO_PORT "gpioa[0]" IO_TYPE=LVCMOS33;

IO_LOC  "gpioa[1]" 26;
IO_PORT "gpioa[1]" IO_TYPE=LVCMOS33;

IO_LOC  "gpioa[2]" 27;
IO_PORT "gpioa[2]" IO_TYPE=LVCMOS33;

IO_LOC  "gpioa[3]" 28;
IO_PORT "gpioa[3]" IO_TYPE=LVCMOS33;

IO_LOC  "gpioa[4]" 29;
IO_PORT "gpioa[4]" IO_TYPE=LVCMOS33;

IO_LOC  "gpioa[5]" 30;
IO_PORT "gpioa[5]" IO_TYPE=LVCMOS33;

IO_LOC  "gpioa[6]" 33;
IO_PORT "gpioa[6]" IO_TYPE=LVCMOS33;

IO_LOC  "gpioa[7]" 34;
IO_PORT "gpioa[7]" IO_TYPE=LVCMOS33;

IO_LOC  "gpiob[0]" 51;
IO_PORT "gpiob[0]" IO_TYPE=LVCMOS33;

IO_LOC  "gpiob[1]" 53;
IO_PORT "gpiob[1]" IO_TYPE=LVCMOS33;

IO_LOC  "gpiob[2]" 49;
IO_PORT "gpiob[2]" IO_TYPE=LVCMOS33;

IO_LOC  "gpiob[3]" 48;
IO_PORT "gpiob[3]" IO_TYPE=LVCMOS33;

IO_LOC  "gpiob[4]" 63;
IO_PORT "gpiob[4]" IO_TYPE=LVCMOS33;

IO_LOC  "gpiob[5]" 57;
IO_PORT "gpiob[5]" IO_TYPE=LVCMOS33;

IO_LOC  "gpiob[6]" 68;
IO_PORT "gpiob[6]" IO_TYPE=LVCMOS33;

IO_LOC  "gpiob[7]" 69;
IO_PORT "gpiob[7]" IO_TYPE=LVCMOS33;

IO_LOC  "gpioc[0]" 70;
IO_PORT "gpioc[0]" IO_TYPE=LVCMOS33;

IO_LOC  "gpioc[1]" 71;
IO_PORT "gpioc[1]" IO_TYPE=LVCMOS33;

IO_LOC  "gpioc[2]" 72;
IO_PORT "gpioc[2]" IO_TYPE=LVCMOS33;

IO_LOC  "gpioc[3]" 73;
IO_PORT "gpioc[3]" IO_TYPE=LVCMOS33;

